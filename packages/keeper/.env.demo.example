# Template for the SECOND keeper instance that tracks the demo escrow.
# Pair this with the default `.env` (web) on the same chain.
#
# Usage:
#   cp .env.demo.example .env.demo
#   npm run dev:demo            # uses .env.demo via dotenv_config_path

RPC_URL_HTTP=http://localhost:8545
RPC_URL_WS=ws://localhost:8545
CHAIN_ID=31337

# Track the demo escrow (deployed by deploy-c2c-demo.ts → demo-31337.json)
KEEPER_LABEL=demo

# Hardhat account[18] (addr 0xdD2FD4...44C0) — distinct from the web keeper's
# account[19] so the two processes don't fight over nonces. Accounts 0-9 are
# reserved by deploy-c2c-demo (merchants/users/verifier).
KEEPER_PRIVATE_KEY=0xde9be858da4a475276426320d5e9262ecfc3ba460bfac56360bfa6c4c28b4ee0

# Distinct ports + state path so the two instances don't collide.
HEALTH_PORT=9092
STATE_FILE_PATH=./data/state-demo.json

POLL_INTERVAL_MS=5000
GRACE_PERIOD_SECONDS=30
LOG_LEVEL=INFO
