# Chain endpoints
RPC_URL_HTTP=http://localhost:8545
RPC_URL_WS=ws://localhost:8545
CHAIN_ID=31337

# Keeper instance label — picks which escrow this process tracks. When two
# deploys coexist on the same chain (e.g. `web` + `demo`), spin up one keeper
# per label. Default = "web" (matches deploy-web.ts's output filename).
KEEPER_LABEL=web

# C2CEscrow deployment is auto-discovered from
#   ../contracts/deployments/<KEEPER_LABEL>-<CHAIN_ID>.json
# (written by `npm run deploy:web` / `npm run deploy:demo` in
# packages/contracts) when ESCROW_ADDRESS + KEEPER_DEPLOYMENTS_FILE are unset.
# Legacy single-deploy file `<CHAIN_ID>.json` is tried as a fallback.
# ESCROW_ADDRESS=0x...
# KEEPER_DEPLOYMENTS_FILE=../contracts/deployments/web-31337.json

# Keeper account — defaults to hardhat account[19] (addr 0x8626f6...1199).
# Accounts 0-9 are reserved by the deploy scripts (merchants/users/verifier)
# so we use the high-numbered slot to avoid nonce contention.
KEEPER_PRIVATE_KEY=0xdf57089febbacf7ba0bc227dafbffa9fc08a93fdc67e1e3c5859f9f4a6c0a4f1

# Bootstrap block for event replay. 0 = use deploymentBlock from the file
# (or 0 if ESCROW_ADDRESS is set without a file). Set to a positive value to
# force a different start block.
KEEPER_DEPLOYMENT_BLOCK=0

# Tick / scheduling
GRACE_PERIOD_SECONDS=30
POLL_INTERVAL_MS=10000
MAX_BATCH_SIZE=20

# Tx caps
GAS_PRICE_CAP_GWEI=100

# Persistence
STATE_FILE_PATH=./data/state.json

# Health endpoint
HEALTH_PORT=9091
LOW_BALANCE_THRESHOLD_ETH=0.01

# Log level (DEBUG | INFO | WARN | ERROR)
LOG_LEVEL=INFO
