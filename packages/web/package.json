{
  "name": "@tlsn/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "copy-plugins": "node -e \"const fs=require('fs'),p='../demo/public/plugins';if(fs.existsSync(p)){fs.cpSync(p,'public/plugins',{recursive:true});console.log('Plugins copied')}else{console.log('No demo plugins found, skipping')}\"",
    "build": "npm run copy-plugins && next build",
    "start": "next start -p 3001",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@pythnetwork/price-service-client": "^1.9.0",
    "@tanstack/react-query": "^5.96.0",
    "ethers": "^6.15.0",
    "lucide-react": "^0.545.0",
    "mysql2": "^3.15.2",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tlsn-monorepo": "file:../..",
    "viem": "^2.37.2"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "^15.5.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
