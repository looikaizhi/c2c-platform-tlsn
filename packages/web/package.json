{
  "name": "@tlsn/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "dev:next-only": "next dev -p 3001",
    "copy-plugins": "node -e \"const fs=require('fs'),p='../demo/public/plugins';if(fs.existsSync(p)){fs.cpSync(p,'public/plugins',{recursive:true});console.log('Plugins copied')}else{console.log('No demo plugins found, skipping')}\"",
    "deploy": "cd ../contracts && npx hardhat run scripts/deploy-web.ts --network localhost",
    "build": "npm run copy-plugins && next build",
    "start": "next start -p 3001",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.11",
    "@wagmi/connectors": "^6.2.0",
    "@wagmi/core": "^2.22.1",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.545.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "undici": "^5.29.0",
    "viem": "^2.37.2",
    "wagmi": "^2.19.5"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "^14.2.35"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
