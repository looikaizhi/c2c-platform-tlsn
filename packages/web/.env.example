# Server-side only. Do NOT prefix with NEXT_PUBLIC_ — that would expose the key to the browser.
# CoinGecko Demo API: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# === WalletConnect / wagmi (client-side) ===
# Get a projectId at https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID="<your-walletconnect-cloud-project-id>"
NEXT_PUBLIC_APP_NAME="zkTLS C2C Exchange"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# Optional escape hatch for injected-only local dev
NEXT_PUBLIC_DISABLE_WC=""
